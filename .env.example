# Local identikey-server (Rust OP). Copy to .env (gitignored);
# scripts/dev-server.sh creates it for you with a fresh wrap key.
# sqlx query macros read DATABASE_URL from here at compile time.
# Variables already set in your shell win over this file.

DATABASE_URL=postgres://YOUR_USER@localhost:5432/identikey-core-sqlx
IDENTIKEY_ISSUER=http://localhost:8080
WEBAUTHN_RP_ID=localhost
WEBAUTHN_EXPECTED_ORIGIN=http://localhost:8080
IDENTIKEY_DATA_DIR=.identikey-dev-data

# 64 hex. Blobs sealed with it open only with it; keep it stable locally.
IDENTIKEY_MANAGED_WRAP_KEY=

# /authorize/dev and a loopback smoke client (never set DEV_LOGIN in prod).
IDENTIKEY_DEV_LOGIN=1
IDENTIKEY_CLIENT_ID=smoke
IDENTIKEY_CLIENT_REDIRECT=http://127.0.0.1:9999/cb
IDENTIKEY_CLIENT_AUTH_METHOD=none

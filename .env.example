# IdentiKey Core Configuration
# ============================

# Database (PostgreSQL for passkeys, devices, tokens)
DATABASE_URL="postgres://localhost:5432/identikey"
# DATABASE_URL="postgres://user:password@host:port/db-name"

# Keycloak Admin API (User Storage)
KEYCLOAK_URL=https://auth.identikey.io
KEYCLOAK_REALM=identikey
KEYCLOAK_CLIENT_ID=admin-cli
KEYCLOAK_CLIENT_SECRET=your-client-secret

# IdentiKey Token Signing (Phase 2)
# IDENTIKEY_ISSUER=https://connect.identikey.io
# IDENTIKEY_SIGNING_KEY_PATH=/path/to/private-key.pem
# Or inline (for environments like Vercel):
# IDENTIKEY_SIGNING_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"

# Apple Sign In Verification (Phase 2)
# APPLE_SERVICES_ID=ai.morphist.app

# Logging
LOG_LEVEL=info

# IdentiKey Core Configuration
# ============================

# Database (PostgreSQL for passkeys, devices, tokens)
DATABASE_URL="postgres://localhost:5432/identikey-core"
# DATABASE_URL="postgres://user:password@host:port/db-name"
DATABASE_URL_TEST="postgres://localhost:5432/identikey-core-test"

# Keycloak Admin API (User Storage)
KEYCLOAK_URL=https://connect.identikey.io
KEYCLOAK_REALM=identikey
KEYCLOAK_CLIENT_ID=admin-cli
KEYCLOAK_CLIENT_SECRET=your-client-secret

# IdentiKey Token Signing
# Generate via: bun run generate-key
# IDENTIKEY_ISSUER=https://connect.identikey.io
# IDENTIKEY_AUDIENCE=morphist-mobile
# IDENTIKEY_SIGNING_KEY='{"kty":"OKP","crv":"Ed25519","d":"...","x":"...","kid":"...","use":"sig","alg":"EdDSA"}'

# Apple Sign In Verification (Phase 2)
# APPLE_SERVICES_ID=ai.morphist.app

# Google Sign In Verification (Bootstrap)
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Production OP (ADR-004). identikey-server is env-registered clients, hashed at boot.
# As of 2026-08-27 https://auth.identikey.me returned Cloudflare 521 (no identikey-server deploy).
# IDENTIKEY_ISSUER=https://auth.identikey.me
# WEBAUTHN_RP_ID=auth.identikey.me
# WEBAUTHN_EXPECTED_ORIGIN=https://auth.identikey.me
# IDENTIKEY_CLIENT_ID=taskmaster
# IDENTIKEY_CLIENT_REDIRECT=https://taskmaster.dev/auth/callback
# IDENTIKEY_CLIENT_SECRET=          # same value as Taskmaster host secret; never log
# IDENTIKEY_CLIENT_AUTH_METHOD=client_secret_basic
# laptop is a second client (pairwise sector is the redirect host, not a second redirect on production):
# IDENTIKEY_CLIENTS='[{"id":"taskmaster-laptop","redirect":"http://127.0.0.1:5173/auth/callback","secret":"...","auth":"client_secret_basic"}]'

# WebAuthn / Passkeys
# rpId must match the origin host the client uses (no trailing slash)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=IdentiKey
# Comma-separated origins for verification (must match client browser/app origin)
# Native apps: android:apk-key-hash:... or iOS equivalent
WEBAUTHN_EXPECTED_ORIGIN=http://localhost:5173

# Pairwise sub salt (ADR-009). 64 hex characters. Leave unset to generate
# IDENTIKEY_DATA_DIR/pairwise.salt on first boot. Rotation is unsupported.
# IDENTIKEY_PAIRWISE_SALT=
# IDENTIKEY_DATA_DIR=.

# Logging
LOG_LEVEL=info

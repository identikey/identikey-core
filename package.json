{
	"name": "identikey-core",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"bin": {
		"kc": "./src/cli/index.ts"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:test:migrate": "export $(grep -v '^#' .env | xargs) && DATABASE_URL=$DATABASE_URL_TEST drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"cli": "bun run src/cli/index.ts",
		"kc": "bun run src/cli/index.ts",
		"mcp": "bun run src/mcp/index.ts",
		"generate-key": "bun run scripts/generate-signing-key.ts"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^4.1.3",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.38.0",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@playwright/test": "^1.56.1",
		"@storybook/addon-a11y": "^10.1.2",
		"@storybook/addon-docs": "^10.1.2",
		"@storybook/addon-svelte-csf": "^5.0.10",
		"@storybook/addon-vitest": "^10.1.2",
		"@storybook/sveltekit": "^10.1.2",
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/kit": "^2.47.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.14",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.0.5",
		"@vitest/coverage-v8": "^4.0.5",
		"drizzle-kit": "^0.31.5",
		"drizzle-orm": "^0.44.6",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.1.2",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"mdsvex": "^0.12.6",
		"playwright": "^1.56.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"storybook": "^10.1.2",
		"svelte": "^5.41.0",
		"svelte-check": "^4.3.3",
		"tailwindcss": "^4.1.14",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.1",
		"vite": "^7.1.10",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.0.5",
		"vitest-browser-svelte": "^2.0.1",
		"dotenv": "^16.4.7"
	},
	"dependencies": {
		"@keycloak/keycloak-admin-client": "^25.0.0",
		"@modelcontextprotocol/sdk": "^1.0.0",
		"@simplewebauthn/server": "^13.2.3",
		"citty": "^0.1.6",
		"jose": "^6.1.3",
		"pino": "^9.5.0",
		"postgres": "^3.4.7",
		"zod": "^3.24.0"
	}
}